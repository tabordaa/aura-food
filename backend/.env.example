# Variables de entorno del Backend

# Clave para firmar los tokens JWT. OBLIGATORIA en producción (ENV=production).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la dejas vacía en desarrollo se usa una clave temporal y las sesiones se cierran al reiniciar la API.
SECRET_KEY=""

# Minutos que dura la sesión (token JWT). Por defecto 480 (8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Costo de domicilio (COP) que se suma a cada pedido y minutos estimados de entrega
DELIVERY_FEE=5000
DELIVERY_MINUTES=45
# Desfase horario de la tienda respecto a UTC (para los indicadores "de hoy"); Colombia = -5
STORE_UTC_OFFSET=-5
# Punto de recogida de la tienda que se muestra en los mapas (por defecto Chapinero, Bogotá)
STORE_LAT=4.6486
STORE_LNG=-74.0628
STORE_ADDRESS="Calle 63 # 13-30, Bogotá"

# Inicio de sesión con Google (opcional). Vacío = desactivado. Ver "Login con Google" en backend/README.md
GOOGLE_CLIENT_ID=""

# "production" desactiva los valores por defecto de desarrollo
ENV="development"

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=""

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=""

# Contraseñas de los usuarios que crea `python seed.py` (admin, domiciliario y cliente de prueba).
# Si una queda vacía, ese usuario no se crea. Las contraseñas de usuarios existentes nunca se sobrescriben.
SEED_ADMIN_PASSWORD=""
SEED_COURIER_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
# Contraseña de los clientes demo que crea seed_demo.py (ana.gomez@, carlos.rios@, valentina.mora@demo.aurafood.com)
SEED_DEMO_PASSWORD=""
